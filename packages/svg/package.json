{
  "name": "@odontogram/svg",
  "version": "0.1.0",
  "description": "Schematic SVG renderer plugin for odontogram",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./catalog/node": {
      "types": "./dist/catalog/load-node.d.ts",
      "import": "./dist/catalog/load-node.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "resources",
    "schema",
    "fixtures/contract"
  ],
  "sideEffects": [
    "dist/style.css"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/catalog/index.ts src/catalog/load-node.ts src/contract/index.ts src/contract/cli/validate-svg.ts src/contract/cli/validate-catalog-svg.ts --format esm --dts --clean && node --input-type=module -e \"import fs from 'node:fs'; fs.copyFileSync('src/style.css', 'dist/style.css')\"",
    "generate:catalog": "npm run build -w @odontogram/dentition && node --experimental-strip-types scripts/generate-catalog.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:svg": "node dist/contract/cli/validate-catalog-svg.js"
  },
  "dependencies": {
    "@odontogram/core": "0.1.0",
    "@odontogram/dentition": "0.1.0",
    "jsdom": "^25.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
