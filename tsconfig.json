{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@odontogram/core": ["./packages/core/src/index.ts"],
      "@odontogram/dentition": ["./packages/dentition/src/index.ts"],
      "@odontogram/svg": ["./packages/svg/src/index.ts"],
      "@odontogram/svg/contract": ["./packages/svg/src/contract/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
