{
  "name": "lib-odontograma",
  "private": true,
  "version": "0.1.0",
  "description": "Framework-independent odontogram library",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:svg": "npm run build -w @odontogram/core -w @odontogram/dentition -w @odontogram/svg && npm run validate:svg -w @odontogram/svg",
    "gallery": "npm run build -w @odontogram/dentition -w @odontogram/svg && npm run dev -w odontogram-svg-gallery",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.10.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
